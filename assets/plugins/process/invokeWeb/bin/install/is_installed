#!/bin/bash
# 実行ホストの os_arch 版 k6 がキャッシュ済み、または版一致のイメージ同梱版
# (stfw:full) があればインストール済みとみなす。欠けていれば false を返し、
# stfw plugin install invokeWeb で補修できるようにする (版の上書きはプロジェクト共通設定で行う)。
case "$(uname -s)" in
  Linux) k6_os=linux ;;
  Darwin) k6_os=macos ;;
  *) echo "invokeWeb: unsupported OS: $(uname -s)"; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) echo "invokeWeb: unsupported arch: $(uname -m)"; exit 1 ;;
esac
os_arch="${k6_os}_${arch}"

k6_bin="${stfw_plugin_cache_dir}/k6/${os_arch}/k6"
# 永続キャッシュが無ければイメージ同梱版 (stfw:full) を使う。設定版と同梱版 (VERSION) が
# 一致するときに限る (解決順は bin/run/execute と同じ)。
bundled="${stfw_plugin_bundled_dir:-}/k6"
version="${stfw_process_invokeWeb_k6_version:-v2.1.0}"
if [ ! -x "${k6_bin}" ] && [ -n "${stfw_plugin_bundled_dir:-}" ] \
  && [ "$(cat "${bundled}/VERSION" 2>/dev/null)" = "${version}" ]; then
  k6_bin="${bundled}/${os_arch}/k6"
fi
if [ ! -x "${k6_bin}" ]; then
  # 同梱版はあるが版だけが食い違う場合は、原因と対処を stderr に出す
  # (stdout は判定にしか使われず利用者に見えない)。
  bundled_version="$(cat "${bundled}/VERSION" 2>/dev/null)"
  if [ -n "${stfw_plugin_bundled_dir:-}" ] && [ -n "${bundled_version}" ] && [ "${bundled_version}" != "${version}" ]; then
    echo "invokeWeb: bundled k6 is ${bundled_version} but k6_version is ${version}" \
      "(set k6_version in config/plugins/process/invokeWeb/config.yml and run \`stfw plugin install invokeWeb\`)" >&2
  fi
  echo "k6 for ${os_arch} is not provisioned (run \`stfw plugin install invokeWeb\`)."
  exit 1
fi

echo "true"
exit 0
