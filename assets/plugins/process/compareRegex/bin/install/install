#!/bin/bash
# compareRegex のプロビジョニング: compare-files のリリース物 (実行ホストの os_arch 版) から
# compare_regex を取り出して永続キャッシュ
# (${stfw_plugin_cache_dir}/compare-files/{os_arch}/compare_regex) に配置する。
# リリース資産・取得元・os_arch の解決は compare (compare_files を取り出す) と同じ。
#
# プロビジョニングモデルは compare と同一の「初回 install 優先」。
# 既にキャッシュ済みなら再ダウンロードしない。compare_files_version を変更したときは
# ${stfw_plugin_cache_dir}/compare-files/ を削除してから再 install すること。
#
# 取得・展開・配置に失敗した場合は非 0 (exit 6) を返す。
#
# 呼び出し元: stfw plugin install / stfw init に加え、Dockerfile の full ステージが
# stfw_plugin_cache_dir=/opt/stfw/bundled + 版 env だけを渡してビルド時に実行する
# (compare と同じ compare-files/{os_arch}/ へ同梱)。配置先レイアウトや env 契約を変えるとイメージビルドも壊れる。
set -uo pipefail

for cmd in curl tar uname; do
  if ! command -v "${cmd}" >/dev/null 2>&1; then
    echo "compareRegex install: ${cmd} is required" >&2
    exit 6
  fi
done

os=""
case "$(uname -s)" in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  *) echo "compareRegex install: unsupported OS: $(uname -s)" >&2; exit 6 ;;
esac
arch=""
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) echo "compareRegex install: unsupported arch: $(uname -m)" >&2; exit 6 ;;
esac
os_arch="${os}_${arch}"

version="${stfw_process_compareRegex_compare_files_version:-v2.2.4}"
# リリース資産名はバージョンに先頭 v を含まない (compare-files_2.2.4_linux_amd64.tar.gz)。
version_num="${version#v}"
# ダウンロード元は既定で GitHub Releases。テスト等で差し替え可能にする (compare と同じ env)。
base="${stfw_compare_files_download_base:-https://github.com/scenario-test-framework/compare-files/releases/download/${version}}"
dest="${stfw_plugin_cache_dir}/compare-files/${os_arch}"

if [ -x "${dest}/compare_regex" ]; then
  exit 0
fi

mkdir -p "${dest}"
tarball="compare-files_${version_num}_${os_arch}.tar.gz"
tmp="$(mktemp -d)"

if ! curl -fsSL "${base}/${tarball}" -o "${tmp}/${tarball}"; then
  echo "compareRegex install: download failed: ${base}/${tarball}" >&2
  rm -rf "${tmp}"
  exit 6
fi
if ! tar xzf "${tmp}/${tarball}" -C "${tmp}"; then
  echo "compareRegex install: extract failed: ${tarball}" >&2
  rm -rf "${tmp}"
  exit 6
fi
bin="$(find "${tmp}" -type f -name compare_regex | head -1)"
if [ -z "${bin}" ]; then
  echo "compareRegex install: compare_regex binary not found in ${tarball}" >&2
  rm -rf "${tmp}"
  exit 6
fi
# 同じディレクトリの一時名へ置いてから最終名へ移す。容量不足などでコピーが途中で失敗したとき、
# 実行権限つきの壊れたバイナリが最終名に残り、is_installed がインストール済みと判定するのを防ぐ。
part="${dest}/.compare_regex.part.$$"
if ! cp "${bin}" "${part}" || ! chmod 755 "${part}" || ! mv -f "${part}" "${dest}/compare_regex"; then
  echo "compareRegex install: failed to place compare_regex for ${os_arch}" >&2
  rm -f "${part}"
  rm -rf "${tmp}"
  exit 6
fi
rm -rf "${tmp}"
exit 0
