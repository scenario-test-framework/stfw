#!/bin/bash
# collectLog: テスト対象ホストから、業務日付の実行開始日時以降のログ行を収集する。
#
# 設定 (config.yml の stfw.process.collectLog.targets):
#   targets[].group : inventory グループ名 (ホスト解決)
#   targets[].user  : ログインユーザー (secret {host}-{user} でパスワード解決)
#   targets[].paths : 収集対象ログのパス正規表現 (posix-extended)
#
# 処理: logfilter バイナリ (host の arch 版) を scp 転送 → ssh で実行して
#   「bizdate の実行開始日時 (stfw_bizdate_start_ts) 以降」のログ行に絞り込み →
#   scp でローカルへ収集 → 転送したバイナリを削除。
# 出力: ${stfw_process_dir}/evidence/{host}/{収集元の絶対パスをそのまま再現}
#
# 前提: 収集先ホストと stfw 実行ホストの時刻が同期していること。
# パスワードは argv 露出を避けるため SSHPASS 環境変数で渡す (sshpass -e。#54)。
# logfilter とその出力は、収集先ホストに mktemp -d で作った専用ディレクトリに置き、
# ホストごとに最後にディレクトリごと消す (共有の /tmp に推測できる名前で置かない。#55)。
set -uo pipefail

evidence_root="${stfw_process_dir}/evidence"
ssh_opts=(-o StrictHostKeyChecking=yes -o ConnectTimeout=10)
rc=0

# rq は値を POSIX sh の単一引用符で囲む。リモートで実行するコマンド文字列に埋め込む値は
# すべてこれを通す (値の中の ' や ; をリモートのシェルに解釈させない。#55)。
# printf %q は bash 専用の書式を出すことがあり、ログインシェルが sh / ash でも通るこの形にする。
# 置換は変数経由で書く (置換文字列に \' を直書きすると bash 3.2 と 5 で結果が変わる)。
rq() {
  local sq="'" esc="'\\''"
  printf "'%s'" "${1//${sq}/${esc}}"
}

# rssh はホストでコマンド文字列を実行する (stdin は渡さない。収集ループの FD を守る)。
rssh() {
  sshpass -e ssh "${ssh_opts[@]}" "${user}@${host}" "$1" < /dev/null
}

# quiet_shell は、ホストのログインシェルが標準出力に何も足さないことを確かめる。
# mktemp の出力 (専用ディレクトリの名前) を ssh の標準出力から受け取るため、案内文などが
# 混ざると名前を取れず、作ったディレクトリを消せなくなる。作る前に確かめる。
# 目印の 1 行だけが返ることを、末尾の改行まで含めて照合する (コマンド置換は末尾の改行を
# 落とすため、最後に "." を足してから比べる)。
# 戻り値: 0 = 静か / 1 = 余計な出力あり / 255 = ssh の失敗。
quiet_shell() {
  local out
  out="$(rssh 'echo stfw-shell-ok'; s=$?; printf '.'; exit "${s}")"
  local s=$?
  [ "${s}" -eq 255 ] && return 255
  [ "${out}" = "stfw-shell-ok"$'\n'"." ] && return 0
  return 1
}

# cleanup_remote は専用ディレクトリをホストから消す。消せなければ残った場所を示して失敗にする。
cleanup_remote() {
  if ! rssh "rm -rf -- $(rq "${remote_dir}")"; then
    echo "collectLog: failed to remove ${host}:${remote_dir}; remove it by hand" >&2
    rc=6
  fi
}

# logfilter は arch ごとに永続キャッシュ → イメージ同梱版 (stfw:full) の順で解決する。
# 同梱版は設定版と同梱版 (VERSION) が一致するときに限る (解決順は bin/install/is_installed と同じ)。
bundled="${stfw_plugin_bundled_dir:-}/logfilter"
use_bundled=0
if [ -n "${stfw_plugin_bundled_dir:-}" ] \
  && [ "$(cat "${bundled}/VERSION" 2>/dev/null)" = "${stfw_process_collectLog_logfilter_version:-v2.0.2}" ]; then
  use_bundled=1
fi

# フィルタ基準時刻: stfw_bizdate_start_ts (RFC3339) を logfilter の
# -tf 形式 'YYYY-MM-DD HH:MM:SS.000' へ変換 (純 bash・タイムゾーンは実行ホスト基準)。
from=""
ts="${stfw_bizdate_start_ts:-}"
if [ -n "${ts}" ]; then
  date_part="${ts%%T*}"
  rest="${ts#*T}"
  time_part="${rest:0:8}"
  from="${date_part} ${time_part}.000"
fi

i=0
while :; do
  group_var="stfw_process_collectLog_targets_${i}_group"
  group="${!group_var:-}"
  [ -z "${group}" ] && break
  user_var="stfw_process_collectLog_targets_${i}_user"
  user="${!user_var:-}"

  # inventory list 失敗時は hosts を空にして for ループを空回りさせ、末尾の
  # i 増分を必ず通す (continue すると同一 target を無限再試行してしまう)。
  hosts=""
  if ! hosts="$(stfw inventory list "${group}")"; then
    echo "collectLog: inventory list failed for group: ${group}" >&2
    rc=6
    hosts=""
  fi
  for host in ${hosts}; do
    if ! arch="$(stfw inventory arch "${host}")"; then
      echo "collectLog: failed to resolve arch for host: ${host}" >&2
      rc=6
      continue
    fi
    if [ -z "${arch}" ]; then
      echo "collectLog: arch is not set for host in inventory: ${host}" >&2
      rc=6
      continue
    fi
    lfbin="${stfw_plugin_cache_dir}/logfilter/${arch}/logfilter"
    if [ ! -x "${lfbin}" ] && [ "${use_bundled}" -eq 1 ]; then
      lfbin="${bundled}/${arch}/logfilter"
    fi
    if [ ! -x "${lfbin}" ]; then
      echo "collectLog: logfilter for ${arch} is not provisioned (run \`stfw plugin install collectLog\`)" >&2
      rc=6
      continue
    fi
    if ! password="$(stfw secret show "${host}" "${user}")"; then
      echo "collectLog: secret not found: ${host}-${user}" >&2
      rc=6
      continue
    fi

    export SSHPASS="${password}"

    quiet_shell
    shell_rc=$?
    if [ "${shell_rc}" -eq 255 ]; then
      echo "collectLog: ssh failed: ${user}@${host}" >&2
      rc=6
      continue
    fi
    if [ "${shell_rc}" -ne 0 ]; then
      echo "collectLog: the login shell on ${host} writes extra output to stdout; the work directory could not be tracked (make the shell quiet for non-interactive sessions)" >&2
      rc=6
      continue
    fi

    # 専用ディレクトリ。mktemp の出力以外は使わない (想定外の出力なら作られていても名前を信用しない)
    remote_dir="$(rssh 'mktemp -d /tmp/stfw.XXXXXXXX')"
    mktemp_rc=$?
    if ! [[ "${remote_dir}" =~ ^/tmp/stfw\.[A-Za-z0-9._-]+$ ]]; then
      echo "collectLog: failed to create a work directory on ${host}" >&2
      rc=6
      continue
    fi
    if [ "${mktemp_rc}" -ne 0 ]; then
      # 名前は返ったが接続か mktemp が失敗した。作られている場合に備えて消してから失敗にする
      echo "collectLog: failed to create a work directory on ${host} (exit ${mktemp_rc})" >&2
      rc=6
      cleanup_remote
      continue
    fi
    remote_lf="${remote_dir}/logfilter"
    remote_out="${remote_dir}/out"
    if ! sshpass -e scp "${ssh_opts[@]}" "${lfbin}" "${user}@${host}:${remote_lf}" < /dev/null; then
      echo "collectLog: failed to transfer logfilter to ${host}" >&2
      rc=6
      cleanup_remote
      continue
    fi
    rssh "chmod 755 $(rq "${remote_lf}")"

    n=0
    while :; do
      path_var="stfw_process_collectLog_targets_${i}_paths_${n}"
      pattern="${!path_var:-}"
      [ -z "${pattern}" ] && break
      n=$((n + 1))

      files="$(rssh "find / -regextype posix-extended -regex $(rq "${pattern}") -type f 2>/dev/null")"
      ssh_rc=$?
      # ssh 自体の失敗 (接続・認証エラー = 255) はエラー扱い。find の権限エラー
      # (一部ディレクトリにアクセスできず exit 1) は正常出力として扱う。
      if [ "${ssh_rc}" -eq 255 ]; then
        echo "collectLog: ssh failed: ${user}@${host}" >&2
        rc=6
        continue
      fi
      # 空白を含むパスを壊さないよう 1 行ずつ処理する。ループ本体の ssh/scp が
      # stdin を消費してループが途中終了しないよう、読み取りは FD 3 を使う。
      while IFS= read -r f <&3; do
        [ -z "${f}" ] && continue
        if [ -n "${from}" ]; then
          lf_cmd="$(rq "${remote_lf}") -f -tf $(rq "${from}") $(rq "${f}") $(rq "${remote_out}")"
        else
          lf_cmd="$(rq "${remote_lf}") -f $(rq "${f}") $(rq "${remote_out}")"
        fi
        if ! rssh "${lf_cmd}"; then
          echo "collectLog: logfilter failed on ${host}:${f}" >&2
          rc=6
          continue
        fi
        destdir="${evidence_root}/${host}$(dirname "${f}")"
        mkdir -p "${destdir}"
        # remote_out は mktemp の名前 (英数字と . _ - /) だけでできているため、scp の
        # パス解釈 (グロブ・旧方式のシェル) に左右されない
        if ! sshpass -e scp "${ssh_opts[@]}" "${user}@${host}:${remote_out}" "${destdir}/$(basename "${f}")" < /dev/null; then
          echo "collectLog: failed to collect ${host}:${f}" >&2
          rc=6
        fi
        rssh "rm -f -- $(rq "${remote_out}")"
      done 3<<< "${files}"
    done

    # 転送した logfilter と出力をディレクトリごと削除
    cleanup_remote
  done
  i=$((i + 1))
done

exit ${rc}
