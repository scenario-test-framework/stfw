#!/bin/bash
# 収集時の前提コマンドが揃い、要求した全 arch の logfilter がキャッシュ済み (または版一致の
# イメージ同梱版 (stfw:full) で補える) ならインストール済みとみなす。一部 arch でも欠けていれば false を返し、
# stfw plugin install collectLog で補修できるようにする。
for cmd in ssh scp sshpass; do
  if ! command -v "${cmd}" >/dev/null 2>&1; then
    echo "${cmd} is not installed."
    exit 1
  fi
done

# arch ごとに永続キャッシュ → イメージ同梱版 (stfw:full) の順で解決する。同梱版は
# 設定版と同梱版 (VERSION) が一致するときに限る (解決順は bin/run/execute と同じ)。
bundled="${stfw_plugin_bundled_dir:-}/logfilter"
version="${stfw_process_collectLog_logfilter_version:-v2.0.0}"
use_bundled=0
if [ -n "${stfw_plugin_bundled_dir:-}" ] \
  && [ "$(cat "${bundled}/VERSION" 2>/dev/null)" = "${version}" ]; then
  use_bundled=1
fi
arches="${stfw_process_collectLog_logfilter_arches:-linux_amd64 linux_arm64 darwin_arm64}"
for arch in ${arches}; do
  if [ -x "${stfw_plugin_cache_dir}/logfilter/${arch}/logfilter" ]; then
    continue
  fi
  if [ "${use_bundled}" -eq 0 ] || [ ! -x "${bundled}/${arch}/logfilter" ]; then
    # 同梱版はあるが版だけが食い違う場合は、原因と対処を stderr に出す
    # (stdout は判定にしか使われず利用者に見えない)。
    bundled_version="$(cat "${bundled}/VERSION" 2>/dev/null)"
    if [ -n "${stfw_plugin_bundled_dir:-}" ] && [ -n "${bundled_version}" ] && [ "${bundled_version}" != "${version}" ]; then
      echo "collectLog: bundled logfilter is ${bundled_version} but logfilter_version is ${version}" \
        "(set logfilter_version in config/plugins/process/collectLog/config.yml and run \`stfw plugin install collectLog\`)" >&2
    fi
    echo "logfilter for ${arch} is not provisioned (run \`stfw plugin install collectLog\`)."
    exit 1
  fi
done

echo "true"
exit 0
