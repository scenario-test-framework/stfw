# STEP: compareRegex プラグインのイメージ同梱フォールバック (stfw:full。AS-BUILT §4.11.1)
# stfw:full は compare と同じ /opt/stfw/bundled/compare-files/{os_arch}/ に compare_regex も同梱し、
# VERSION を共有する。ここでは同梱ディレクトリをフィクスチャで再現する。
# curl(DL) は常に失敗させ、同梱経路ではダウンロードしないことを担保する。
#
# 検証内容:
#   - キャッシュも同梱も無ければ未プロビジョニング (run exit 6)
#   - 永続キャッシュが無くても、設定版と一致する同梱版で install なしに run できる
#   - 同梱が設定版と一致すれば plugin install は「インストール済み」(exit 3) で DL しない
#   - 同梱に compare_files しか無い (compare_regex が無い) 場合は同梱を使わない
#   - 設定版と同梱版が異なれば同梱を使わず、原因と対処 (compareRegex の共通設定) を出す
#   - 永続キャッシュと同梱の両方があれば永続キャッシュを優先する

env PATH=${WORK}/fakebin:${PATH}
chmod 755 fakebin/curl
chmod 755 fakebin/fakecompareregex
chmod 755 fakebin/mkbin

# --- キャッシュも同梱も無い: 未プロビジョニング ---
execcode 6 stfw run rx
stderr 'is not installed'

# --- 同梱に compare_files しか無い: compare_regex は解決できない ---
exec mkbin bundled/compare-files compare_files v2.2.4 bundled
env stfw_plugin_bundled_dir=${WORK}/bundled
execcode 6 stfw run rx
stderr 'is not installed'

# --- 同梱あり・キャッシュなし: install なしで run が成功し、キャッシュは作られない ---
exec mkbin bundled/compare-files compare_regex v2.2.4 bundled
exec stfw run rx
stderr 'compare_regex=bundled'
! exists .stfw/cache/plugins/compareRegex/compare-files

# --- 同梱が設定版と一致: plugin install はインストール済み (exit 3) で DL しない ---
execcode 3 stfw plugin install compareRegex
! stderr 'download'
! exists .stfw/cache/plugins/compareRegex/compare-files

# --- 設定版と同梱版が異なる: 同梱は使わず、不一致の理由と compareRegex の共通設定を案内する ---
execcode 6 stfw run rxver
stderr 'is not installed'
stderr 'bundled compare-files is v2\.2\.4 but compare_files_version is v2\.2\.3'
stderr 'config/plugins/process/compareRegex/config\.yml'
! stderr 'compare_regex=bundled'
# プロジェクト共通設定で版を上書きした場合、install は同梱を使わず DL を試みる
mkdir config/plugins/process/compareRegex
cp config.v999.yml config/plugins/process/compareRegex/config.yml
execcode 6 stfw plugin install compareRegex
stderr 'download failed'
rm config/plugins/process/compareRegex/config.yml

# --- 永続キャッシュと同梱の両方がある: 永続キャッシュを優先する ---
exec mkbin .stfw/cache/plugins/compareRegex/compare-files compare_regex v2.2.4 cache
exec stfw run rx
stderr 'compare_regex=cache'
! stderr 'compare_regex=bundled'

-- stfw.yml --
stfw:
  project_version: 0.1.0
  loglevel: "info"
-- config.v999.yml --
stfw:
  process:
    compareRegex:
      compare_files_version: v9.9.9
-- scenario/rx/metadata.yml --
description:
-- scenario/rx/_10_99990101/metadata.yml --
description:
-- scenario/rx/_10_99990101/_10_col_scripts/metadata.yml --
description:
-- scenario/rx/_10_99990101/_10_col_scripts/config/config.yml --
stfw:
  process:
    scripts: {}
-- scenario/rx/_10_99990101/_10_col_scripts/scripts/100_gen --
#!/bin/bash
mkdir -p "${stfw_process_dir}/evidence/host1"
printf 'hello\n' > "${stfw_process_dir}/evidence/host1/report_20240101093015.txt"
exit 0
-- scenario/rx/_10_99990101/_20_asrt_compareRegex/metadata.yml --
description:
-- scenario/rx/_10_99990101/_20_asrt_compareRegex/config/config.yml --
stfw:
  process:
    compareRegex: {}
-- scenario/rx/_10_99990101/_20_asrt_compareRegex/config/compare_target.csv --
expect/_10_col_scripts/host1,actual/_10_col_scripts/host1,report_[0-9]{14}\.txt
-- scenario/rx/_10_99990101/_20_asrt_compareRegex/expect/_10_col_scripts/host1/report_20240101000000.txt --
hello
