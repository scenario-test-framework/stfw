# STEP: collectLog の構造化ログ (JSON Lines / logfmt) 対応 (AS-BUILT §4.8。logfilter v2.1.0)
# curl(DL) / ssh / scp / sshpass はモックし、擬似リモートから収集する。モック ssh は logfilter の
# 起動引数を remote/{host}/lf_args.log に、接続そのものを remote/calls.log に記録する。
#
# 検証内容:
#   - targets[] の log_format / timestamp_key / timestamp_format が、エントリごとに -lf / -tk / -tfmt で渡る
#   - 書かないエントリ (log_format 既定 text) には構造化ログのオプションを渡さない
#   - 値が不正なら、どのホストにも接続する前に exit 6 (fail-fast)

env PATH=${WORK}/fakebin:${PATH}
env STFW_TEST_REMOTE=${WORK}/remote
# ジャーナルの時刻 (UTC) と -tf (ローカル時刻) を同じ時計で比べられるようにする
env TZ=UTC
chmod 755 fakebin/ssh
chmod 755 fakebin/scp
chmod 755 fakebin/sshpass
chmod 755 fakebin/curl
chmod 755 fakebin/fakelogfilter
chmod 755 fakebin/checktf

mkdir lfsrc
mkdir lfsrc/logfilter_v2.1.0_linux_amd64
cp fakebin/fakelogfilter lfsrc/logfilter_v2.1.0_linux_amd64/logfilter
exec tar czf lf.tar.gz -C lfsrc logfilter_v2.1.0_linux_amd64
env STFW_TEST_LF_TARBALL=${WORK}/lf.tar.gz
exec stfw plugin install collectLog
exec stfw secret keygen
exec stfw secret set web01 appuser secretpw

# --- エントリごとに形式と時刻キーを渡す ---
exec stfw run lf
# -tf は全エントリで、今回の業務日付の開始時刻 (ジャーナルの bizdate の node_start) を秒まで同じ値で渡す
latestrun . RUN
exec checktf .stfw/runs/$RUN/journal.jsonl remote/web01/lf_args.log
exec cat remote/web01/lf_args.log
# テキスト形式 (既定) のエントリは従来どおり -f -tf だけ
stdout '^/var/log/app/app\.log \[-f\] \[-tf\] \[[0-9-]+ [0-9:.]+\] \[/var/log/app/app\.log\] \[[^]]+\]$'
! stdout '^/var/log/app/app\.log .*-lf'
# JSON Lines のエントリは -lf json -tk log.ts -tfmt unixms を足す
stdout '^/var/log/app/app\.jsonl \[-f\] \[-lf\] \[json\] \[-tk\] \[a''b;x\] \[-tfmt\] \[unixms\] \[-tf\] \[[0-9-]+ [0-9:.]+\] \[/var/log/app/app\.jsonl\] \[[^]]+\]$'
# logfmt で時刻キーを省いたエントリは -lf logfmt だけ (時刻キーは logfilter の既定の候補を探す)
stdout '^/var/log/app/app\.logfmt \[-f\] \[-lf\] \[logfmt\] \[-tf\] \[[0-9-]+ [0-9:.]+\] \[/var/log/app/app\.logfmt\] \[[^]]+\]$'
! stdout 'app\.logfmt .*-tk'
# logfmt でも明示した時刻キーと形式を渡す (logfmt ではドットもキー名の一部)
stdout '^/var/log/app/app2\.logfmt \[-f\] \[-lf\] \[logfmt\] \[-tk\] \[event\.ts\] \[-tfmt\] \[unixus\] \[-tf\] '
# キー名の両端に引用符があると logfilter が一組取り除くため、一組足して渡す
stdout '^/var/log/app/quoted\.jsonl \[-f\] \[-lf\] \[json\] \[-tk\] \[""when""\] \[-tf\] '
! exists x
latestrun . RUN
exists .stfw/runs/$RUN/workspace/lf/_10_99990101/_10_grp_collectLog/evidence/web01/var/log/app/app.jsonl

# --- 値が不正: どのホストにも接続せずに exit 6 ---
rm remote/calls.log
execcode 6 stfw run lfbadformat
stderr 'invalid log_format in targets\[1\]: xml \(must be text, json or logfmt\)'
! exists remote/calls.log

execcode 6 stfw run lfbadtsformat
stderr 'invalid timestamp_format in targets\[1\]: seconds \(must be auto, unix, unixms, unixus or unixns\)'
! exists remote/calls.log

execcode 6 stfw run lftextkey
stderr 'timestamp_key in targets\[1\] requires log_format json or logfmt'
! exists remote/calls.log

execcode 6 stfw run lftexttsformat
stderr 'timestamp_format in targets\[1\] requires log_format json or logfmt'
! exists remote/calls.log

execcode 6 stfw run lfemptykey
stderr 'invalid timestamp_key in targets\[1\]: \(empty\)'
! exists remote/calls.log

execcode 6 stfw run lfemptytsformat
stderr 'invalid timestamp_format in targets\[1\]: \(empty\)'
! exists remote/calls.log

execcode 6 stfw run lflistmap
stderr 'log_format in targets\[1\] must be a single value, not a list'
! exists remote/calls.log

execcode 6 stfw run lflist
stderr 'log_format in targets\[1\] must be a single value, not a list'
! exists remote/calls.log

execcode 6 stfw run lfemptyformat
stderr 'invalid log_format in targets\[1\]: \(empty\)'
! exists remote/calls.log

-- stfw.yml --
stfw:
  project_version: 0.1.0
  loglevel: "info"
  inventory: staging.yml
-- config/inventory/staging.yml --
stfw_inventory:
  - web:
    - host: web01
      arch: linux_amd64
-- scenario/lf/metadata.yml --
description:
-- scenario/lf/_10_99990101/metadata.yml --
description:
-- scenario/lf/_10_99990101/_10_grp_collectLog/metadata.yml --
description:
-- scenario/lf/_10_99990101/_10_grp_collectLog/config/config.yml --
stfw:
  process:
    collectLog:
      targets:
        - group: web
          user: appuser
          log_format_note: legacy
          paths:
            - /var/log/app/app\.log
        - group: web
          user: appuser
          log_format: json
          timestamp_key: "a'b;x"
          timestamp_format: unixms
          paths:
            - /var/log/app/app\.jsonl
        - group: web
          user: appuser
          log_format: logfmt
          paths:
            - /var/log/app/app\.logfmt
        - group: web
          user: appuser
          log_format: logfmt
          timestamp_key: event.ts
          timestamp_format: unixus
          paths:
            - /var/log/app/app2\.logfmt
        - group: web
          user: appuser
          log_format: json
          timestamp_key: '"when"'
          paths:
            - /var/log/app/quoted\.jsonl
