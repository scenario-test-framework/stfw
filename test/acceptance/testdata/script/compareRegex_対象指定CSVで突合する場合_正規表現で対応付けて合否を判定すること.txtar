  process:
    scripts: {}
-- scenario/rx/_10_99990101/_10_col_scripts/scripts/100_gen --
#!/bin/bash
mkdir -p "${stfw_process_dir}/evidence/host1/out"
printf 'hello\n' > "${stfw_process_dir}/evidence/host1/out/report_20240101093015.csv"
printf 'total,1\n' > "${stfw_process_dir}/evidence/host1/out/summary.csv"
exit 0
