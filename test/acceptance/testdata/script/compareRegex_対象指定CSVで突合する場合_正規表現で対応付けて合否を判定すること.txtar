-- fakebin/curl --
#!/bin/bash
# curl -fsSL <url> -o <out> をフィクスチャ tarball のコピーで再現
out=""
while [ $# -gt 0 ]; do
  case "$1" in -o) out="$2"; shift 2;; *) shift;; esac
done
cp "${STFW_TEST_CF_TARBALL}" "${out}"
exit 0
-- fakebin/wrongbinary --
#!/bin/bash
# リリース物の compare_files の代役。compareRegex から起動されたら取り違えなので失敗する
echo "wrong binary: compare_files was started" >&2
exit 6
-- fakebin/fakecompareregex --
#!/bin/bash
# fake compare_regex: 比較対象設定 CSV (左ディレクトリ,右ディレクトリ,ファイル名正規表現) の各行について、
# 左右それぞれのディレクトリ直下で名前順に最初に一致したファイルを突合し CompareSummary.csv を出力する
# (compare-files internal/bulk/regex.go と同じ判定)。0=全一致 / 3=差分 / 6=エラー。
# 受け取った CSV パス・-od・-config・COMPAREFILES_CLASSPATH を result/ に記録する。-od は必須
# (stfw は結果の出力先を必ず -od で渡す契約)。片側のディレクトリが無い行の扱いも本物と同じ
# (compare-files internal/bulk/regex.go writeNgResult)。
# 正規表現は ERE で評価する (本物は regexp2。テストの CSV は両方で同じ意味の書き方にする)。
out=""
cfgopt="(none)"
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -od | --outputDir) out="$2"; shift 2 ;;
    -config | --configFile) cfgopt="$2"; shift 2 ;;
    -*) shift ;;
    *) args+=("$1"); shift ;;
  esac
done
target="${args[0]:-}"
if [ -z "${target}" ] || [ ! -f "${target}" ]; then
  echo "fake compare_regex: need TARGET_FILE_PATH" >&2
  exit 6
fi
if [ "${STFW_TEST_CF_FAIL:-0}" = "1" ]; then
  echo "fake compare_regex: simulated error" >&2
  exit 6
fi
if [ "${STFW_TEST_CF_NORESULT:-0}" = "1" ]; then
  echo "compare-files 2.2.4"
  exit 0
fi
if [ -z "${out}" ]; then
  echo "fake compare_regex: -od is required" >&2
  exit 6
fi
rm -rf "${out}"
mkdir -p "${out}"
printf '%s\n' "${target}" > "${out}/target.txt"
printf '%s\n' "${out}" > "${out}/od.txt"
printf '%s\n' "${cfgopt}" > "${out}/configopt.txt"
printf '%s\n' "${COMPAREFILES_CLASSPATH:-(empty)}" > "${out}/classpath.txt"
summary="${out}/CompareSummary.csv"
echo "Status,Left,Right" > "${summary}"

# first_match {dir} {regex}: dir 直下で名前順に最初に一致したファイルのパスを出す
first_match() {
  local name
  while IFS= read -r name; do
    if [[ "${name}" =~ ^($2)$ ]]; then
      printf '%s\n' "$1/${name}"
      return 0
    fi
  done < <(LC_ALL=C ls -1 "$1")
  return 1
}

rc=0
err=0
while IFS= read -r line; do
  line="${line%$'\r'}"
  case "${line}" in '' | \#* | '"#'*) continue ;; esac
  IFS=, read -r left right re <<< "${line}"
  unq() { local v="$1"; [[ "${v}" == \"*\" ]] && v="${v:1:${#v}-2}"; printf '%s' "${v}"; }
  left="$(unq "${left}")"; right="$(unq "${right}")"; re="$(unq "${re}")"
  if [ -z "${re}" ]; then
    echo "fake compare_regex: invalid line (need 3 columns): ${line}" >&2
    exit 6
  fi
  lf=""; rf=""
  [ -d "${left}" ] && lf="$(first_match "${left}" "${re}")"
  [ -d "${right}" ] && rf="$(first_match "${right}" "${re}")"
  if [ -n "${lf}" ] && [ -n "${rf}" ]; then
    if diff -q "${lf}" "${rf}" > /dev/null 2>&1; then
      echo "OK,${lf},${rf}" >> "${summary}"
    else
      echo "NG,${lf},${rf}" >> "${summary}"; rc=3
    fi
  elif [ -n "${lf}" ]; then
    echo "LeftOnly,${lf},${right}/${re}" >> "${summary}"; rc=3
  elif [ -n "${rf}" ]; then
    echo "RightOnly,${left}/${re},${rf}" >> "${summary}"; rc=3
  elif [ -d "${left}" ] && [ ! -d "${right}" ]; then
    echo "LeftOnly,${left},[DirNotExist]${right}" >> "${summary}"; rc=3
  elif [ ! -d "${left}" ] && [ -d "${right}" ]; then
    echo "RightOnly,[DirNotExist]${left},${right}" >> "${summary}"; rc=3
  else
    echo "Error,${left}/${re},${right}/${re}" >> "${summary}"; err=1
  fi
done < "${target}"
[ "${err}" -eq 1 ] && exit 6
exit ${rc}
