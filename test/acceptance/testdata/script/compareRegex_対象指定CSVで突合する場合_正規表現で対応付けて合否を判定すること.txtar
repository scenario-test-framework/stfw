# STEP: compareRegex プラグイン (比較対象設定 CSV の正規表現で expect と actual を対応付けて突合する。AS-BUILT §4.11.1)
# curl(DL) はモックし、フェイク compare_regex で正規表現比較を再現する。
# 収集系プロセスの代役として scripts プロセスが「名前に出力時刻を含む」evidence を生成する。
# CSV の正規表現は ERE (フェイク) と Java 互換 (本物) で同じ意味になる書き方 ([0-9]{14}) にする。
#
# 検証内容:
#   - install が compare-files のリリース物から compare_regex をキャッシュする
#   - 名前の違うファイルを正規表現で対応付けて一致 → Success、差分 → exit 6
#   - actual/ は compare と同じく evidence への file-level symlink で組み立てる
#   - プロジェクト共通の比較ルールは compare のディレクトリを注入する (compareRegex 側は注入しない)
#   - プロセスローカルの起動設定は -config で明示指定する
#   - on_mismatch: warn は差分を Warn として続行、不正値は exit 6
#   - CSV が無い / データ行が無い / 片側だけ一致 / compare_regex のエラー / evidence 不在は exit 6

env PATH=${WORK}/fakebin:${PATH}
chmod 755 fakebin/curl
chmod 755 fakebin/fakecompareregex

# compare-files リリース tarball のフィクスチャ (本物と同じく compare_files と compare_regex を含む)。
# compare_files は起動されたら固有のメッセージで失敗させ、取り違えて配置したら分かるようにする
mkdir cfsrc
cp fakebin/fakecompareregex cfsrc/compare_regex
cp fakebin/wrongbinary cfsrc/compare_files
chmod 755 cfsrc/compare_regex
chmod 755 cfsrc/compare_files
exec tar czf cf.tar.gz -C cfsrc compare_files compare_regex
env STFW_TEST_CF_TARBALL=${WORK}/cf.tar.gz

# --- プロビジョニング: compare_regex が compareRegex のキャッシュへ置かれる ---
exec stfw plugin install compareRegex
exec find .stfw/cache/plugins/compareRegex/compare-files -type f
stdout '/compare_regex$'
! stdout '/compare_files$'

# --- 一致: 出力時刻の違うファイル名を正規表現で対応付け、Success ---
exec stfw run rx
stdout 'run_id: _'
latestrun . RUN
# actual/ は evidence への file-level symlink
exec readlink .stfw/runs/$RUN/workspace/rx/_10_99990101/_20_asrt_compareRegex/actual/_10_col_scripts/host1/out/report_20240101093015.csv
stdout '_10_col_scripts/evidence/host1/out/report_20240101093015.csv'
exec cat .stfw/runs/$RUN/workspace/rx/_10_99990101/_20_asrt_compareRegex/result/CompareSummary.csv
stdout 'OK,expect/_10_col_scripts/host1/out/report_20240101000000.csv,actual/_10_col_scripts/host1/out/report_20240101093015.csv'
stdout 'OK,expect/_10_col_scripts/host1/out/summary.csv,actual/_10_col_scripts/host1/out/summary.csv'
# 比較対象設定はプロセスローカルの config/compare_target.csv を渡す
exec cat .stfw/runs/$RUN/workspace/rx/_10_99990101/_20_asrt_compareRegex/result/target.txt
stdout '^config/compare_target\.csv$'
# 結果の出力先は -od でプロセスの result/ を指定する (起動設定の outputDir より優先させる)
exec cat .stfw/runs/$RUN/workspace/rx/_10_99990101/_20_asrt_compareRegex/result/od.txt
stdout '/workspace/rx/_10_99990101/_20_asrt_compareRegex/result$'
# プロジェクト共通の比較ルールは compare のディレクトリを注入し、compareRegex 側は注入しない
exec cat .stfw/runs/$RUN/workspace/rx/_10_99990101/_20_asrt_compareRegex/result/classpath.txt
stdout 'config/plugins/process/compare$'
! stdout 'plugins/process/compareRegex'
# プロセスローカルの起動設定は -config で明示指定する
exec cat .stfw/runs/$RUN/workspace/rx/_10_99990101/_20_asrt_compareRegex/result/configopt.txt
stdout '^\./config/compare_files\.json$'
# scenario/ 正本には書き込まれない
! exists scenario/rx/_10_99990101/_20_asrt_compareRegex/actual
! exists scenario/rx/_10_99990101/_20_asrt_compareRegex/result

# --- 既存の COMPAREFILES_CLASSPATH がある: `:` 区切りで末尾に連結される ---
env COMPAREFILES_CLASSPATH=/preset/dir
exec stfw run rx
latestrun . RUN
exec cat .stfw/runs/$RUN/workspace/rx/_10_99990101/_20_asrt_compareRegex/result/classpath.txt
stdout '^/preset/dir:.*config/plugins/process/compare$'
env COMPAREFILES_CLASSPATH=

# --- compare_regex 自体のエラー (exit 6) は差分とは別メッセージで exit 6 ---
env STFW_TEST_CF_FAIL=1
execcode 6 stfw run rx
stderr 'compare-files failed'
env STFW_TEST_CF_FAIL=0

# --- 差分: 対応付けたファイルの中身が違う → exit 6 (on_mismatch 既定 error) ---
execcode 6 stfw run rxng
stderr 'mismatch detected'
latestrun . RUN
exec cat .stfw/runs/$RUN/workspace/rxng/_10_99990101/_20_asrt_compareRegex/result/CompareSummary.csv
stdout 'NG,'
# プロセスローカルの起動設定が無ければ -config を付けない
exec cat .stfw/runs/$RUN/workspace/rxng/_10_99990101/_20_asrt_compareRegex/result/configopt.txt
stdout '^\(none\)$'

# --- 片側だけ一致: 実績値側に正規表現と一致するファイルが無い → LeftOnly で exit 6 ---
execcode 6 stfw run rxlo
stderr 'mismatch detected'
latestrun . RUN
exec cat .stfw/runs/$RUN/workspace/rxlo/_10_99990101/_20_asrt_compareRegex/result/CompareSummary.csv
stdout 'LeftOnly,'

# --- on_mismatch: warn は差分を Warn として記録し、後続を実行する (run は exit 3) ---
execcode 3 stfw run rxwarn
stderr 'mismatch detected'
exists executed_after_compareRegex.txt

# --- on_mismatch の不正値は fail-fast (exit 6) ---
execcode 6 stfw run rxbad
stderr 'invalid on_mismatch'

# --- 比較対象設定 CSV が無い → exit 6。ワークスペースに残っていた古い比較結果
#     (前段が書き込んで再現する。resume で前 run から引き継いだ場合と同じ状態) は今回の結果として残らない ---
execcode 6 stfw run rxnocsv
stderr 'compare target file not found'
latestrun . RUN
exists .stfw/runs/$RUN/workspace/rxnocsv/_10_99990101/stale_planted.txt
! exists .stfw/runs/$RUN/workspace/rxnocsv/_10_99990101/_20_asrt_compareRegex/result/CompareSummary.csv
! exists .stfw/runs/$RUN/workspace/rxnocsv/_10_99990101/_20_asrt_compareRegex/actual/stale.txt

# --- CSV にデータ行が無い (CRLF の空行・コメント・クォートした "# のコメントだけ) → exit 6 (対象 0 件の素通りを防ぐ) ---
execcode 6 stfw run rxemptycsv
stderr 'no compare targets'

# --- "" だけの行 (空セルを保存した CSV) はデータ行にならない → exit 6 ---
execcode 6 stfw run rxquoted
stderr 'no compare targets'

# --- 右ディレクトリに expect/ を書いた (期待値どうしの比較になる) → exit 6 ---
execcode 6 stfw run rxself
stderr 'left must be under expect/\{process\}/ and right under actual/\{process\}/'

# --- 片側のディレクトリが無い: 本物と同じく差分 (RightOnly) で exit 6 (on_mismatch 既定 error) ---
execcode 6 stfw run rxnodir
stderr 'mismatch detected'
latestrun . RUN
exec cat .stfw/runs/$RUN/workspace/rxnodir/_10_99990101/_20_asrt_compareRegex/result/CompareSummary.csv
stdout 'RightOnly,'

# --- 全セルをクォートした CSV (出力ツールの既定) も一致すれば Success ---
exec stfw run rxquotedok
latestrun . RUN
exec cat .stfw/runs/$RUN/workspace/rxquotedok/_10_99990101/_20_asrt_compareRegex/result/CompareSummary.csv
stdout 'OK,expect/_10_col_scripts/host1/out/report_20240101000000.csv,actual/_10_col_scripts/host1/out/report_20240101093015.csv'

# --- クォート内の "" は " 1 文字 (その後のカンマで列が分かれない) → 3 列として読み、一致すれば Success ---
exec stfw run rxescaped

# --- CR 単独の行区切り (compare-files は CR でもレコードを分ける) → 比較の前に exit 6 ---
execcode 6 stfw run rxbarecr
stderr 'bare CR is not supported'

# --- クォート内の改行 (コメントがデータ行を飲み込む書き方) → 比較の前に exit 6 ---
execcode 6 stfw run rxmultiline
stderr 'quoted values must not contain line breaks'

# --- 収集系 process 名を省いた (expect / actual の直下を指す) → exit 6 ---
execcode 6 stfw run rxnoproc
stderr 'left must be under expect/\{process\}/ and right under actual/\{process\}/'

# --- フィールド途中の " は文字、カンマ直後の " はクォート開始 (compare-files と同じ読み方)。
#     コメント行の途中でクォートが開いたまま行末に達すると、後続のデータ行を飲み込むため比較の前に exit 6 ---
execcode 6 stfw run rxcomment
stderr 'quoted values must not contain line breaks'

# --- カンマを含む正規表現をクォートしない (4 列になる) → exit 6 ---
execcode 6 stfw run rxcommas
stderr 'need 3 columns'

# --- actual/{process} から .. で expect/ へ戻る指定 (期待値どうしの比較になる) → exit 6 ---
execcode 6 stfw run rxdotdot
stderr 'left must be under expect/\{process\}/ and right under actual/\{process\}/'

# --- on_mismatch を明示的に空にした (未定義の変数の展開など) → 設定不正で exit 6 ---
execcode 6 stfw run rxemptyopt
stderr 'invalid on_mismatch'

# --- compare_regex が比較せずに exit 0 で終わった (COMPAREFILES_OPT の -v など) → 成功として扱わず exit 6 ---
env STFW_TEST_CF_NORESULT=1
execcode 6 stfw run rx
stderr 'produced no result'
env STFW_TEST_CF_NORESULT=0

# --- BOM 付き UTF-8 の CSV → exit 6 (1 行目が読めず比較が抜けるのを防ぐ) ---
execcode 6 stfw run rxbom
stderr 'must be UTF-8 without BOM'

# --- expect が参照する収集 process の evidence が無い → exit 6 ---
execcode 6 stfw run rxnoev
stderr 'evidence not found'

-- stfw.yml --
stfw:
  project_version: 0.1.0
  loglevel: "info"
-- config/plugins/process/compare/compare_layout/shared.json --
{
  "layoutList": []
}
-- config/plugins/process/compareRegex/compare_layout/ignored.json --
{
  "layoutList": []
}
-- scenario/rx/metadata.yml --
