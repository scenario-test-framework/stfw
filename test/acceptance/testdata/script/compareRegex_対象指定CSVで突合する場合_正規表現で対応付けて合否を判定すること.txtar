#!/bin/bash
mkdir -p "${stfw_process_dir}/evidence/host1/out"
printf 'hello\n' > "${stfw_process_dir}/evidence/host1/out/report_20240101093015.csv"
# ワークスペースの compareRegex プロセスに古い比較結果を置く (掃除されることの確認用)
cmp="${stfw_bizdate_dir}/_20_asrt_compareRegex"
mkdir -p "${cmp}/result" "${cmp}/actual"
printf 'Status,Left,Right\nSTALE,old,run\n' > "${cmp}/result/CompareSummary.csv"
printf 'stale\n' > "${cmp}/actual/stale.txt"
touch "${stfw_bizdate_dir}/stale_planted.txt"
exit 0
