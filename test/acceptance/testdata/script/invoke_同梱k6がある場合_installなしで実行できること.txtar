-- scenario/invwebver/_10_99990101/_10_act_invokeWeb/script.js --
export const options = { scenarios: {} }
-- fakebin/mkbin --
#!/bin/bash
# mkbin {dir} {version} {label}: {dir}/VERSION と {dir}/{os_arch}/k6 を作る。
# k6 は fakek6 を呼ぶラッパーで、起動時に stderr へ「k6={label}」を出す
# (どの配置のバイナリが使われたかを識別する)。os_arch はプラグインと同じ uname 対応 (k6 は macos 命名)。
dir="$1"; version="$2"; label="$3"
case "$(uname -s)" in Linux) os=linux ;; Darwin) os=macos ;; *) exit 1 ;; esac
case "$(uname -m)" in x86_64 | amd64) arch=amd64 ;; aarch64 | arm64) arch=arm64 ;; *) exit 1 ;; esac
mkdir -p "${dir}/${os}_${arch}"
echo "${version}" > "${dir}/VERSION"
printf '#!/bin/bash\necho "k6=%s" >&2\nexec fakek6 "$@"\n' "${label}" > "${dir}/${os}_${arch}/k6"
chmod 755 "${dir}/${os}_${arch}/k6"
-- fakebin/curl --
#!/bin/bash
# 同梱経路ではダウンロードしないことを担保するため、常に失敗させる
exit 22
-- fakebin/fakek6 --
#!/bin/bash
# fake k6: run [flags] script。--summary-export にダミー JSON を書く。
summary=""
while [ $# -gt 0 ]; do
  case "$1" in
    --summary-export) summary="$2"; shift 2 ;;
    *) shift ;;
  esac
done
echo "fake k6: K6_BROWSER_HEADLESS=${K6_BROWSER_HEADLESS:-unset}"
if [ -n "${summary}" ]; then
  mkdir -p "$(dirname "${summary}")"
  echo '{"metrics":{}}' > "${summary}"
fi
exit 0
