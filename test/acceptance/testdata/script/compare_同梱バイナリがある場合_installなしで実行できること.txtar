-- fakebin/mkbin --
#!/bin/bash
# mkbin {dir} {bin} {version} {label}: {dir}/VERSION と {dir}/{os_arch}/{bin} を作る。
# {bin} は fakecomparefiles を呼ぶラッパーで、起動時に stderr へ「{bin}={label}」を出す
# (どの配置のバイナリが使われたかを識別する)。os_arch はプラグインと同じ uname 対応。
dir="$1"; bin="$2"; version="$3"; label="$4"
case "$(uname -s)" in Linux) os=linux ;; Darwin) os=darwin ;; *) exit 1 ;; esac
case "$(uname -m)" in x86_64 | amd64) arch=amd64 ;; aarch64 | arm64) arch=arm64 ;; *) exit 1 ;; esac
mkdir -p "${dir}/${os}_${arch}"
echo "${version}" > "${dir}/VERSION"
printf '#!/bin/bash\necho "%s=%s" >&2\nexec fakecomparefiles "$@"\n' "${bin}" "${label}" > "${dir}/${os}_${arch}/${bin}"
chmod 755 "${dir}/${os}_${arch}/${bin}"
-- fakebin/curl --
#!/bin/bash
# 同梱経路ではダウンロードしないことを担保するため、常に失敗させる
exit 22
-- fakebin/fakecomparefiles --
#!/bin/bash
# fake compare_files: 左(expect)配下の各ファイルを右(actual)と突合する。0=全一致 / 3=差分。
out="result"
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -od | --outputDir) out="$2"; shift 2 ;;
    -config | --configFile) shift 2 ;;
    -*) shift ;;
    *) args+=("$1"); shift ;;
  esac
done
left="${args[0]}"
right="${args[1]}"
mkdir -p "${out}"
echo "Status,Left,Right" > "${out}/CompareSummary.csv"
rc=0
while IFS= read -r f; do
  r="${right}/${f#"${left}/"}"
  if [ -e "${r}" ] && diff -q "${f}" "${r}" > /dev/null 2>&1; then
    echo "OK,${f},${r}" >> "${out}/CompareSummary.csv"
  else
    echo "NG,${f},${r}" >> "${out}/CompareSummary.csv"; rc=3
  fi
done < <(find "${left}" -type f)
exit ${rc}
