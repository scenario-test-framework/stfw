# STEP: compare プラグインのイメージ同梱フォールバック (stfw:full)
# stfw:full は compare-files を /opt/stfw/bundled/compare-files/{os_arch}/compare_files に同梱し、
# stfw_plugin_bundled_dir で公開する。ここでは同梱ディレクトリをフィクスチャで再現する。
# curl(DL) は常に失敗させ、同梱経路ではダウンロードしないことを担保する。
#
# 検証内容:
#   - 永続キャッシュが無くても、設定版と一致する同梱版で install なしに run できる
#   - 同梱が設定版と一致すれば plugin install は「インストール済み」(exit 3) で DL しない
#   - 設定版と同梱版が異なれば同梱を使わず未プロビジョニング扱い (run exit 6 / install は DL へ)
#   - 永続キャッシュと同梱の両方があれば永続キャッシュを優先する (初回 install 優先)

env PATH=${WORK}/fakebin:${PATH}
chmod 755 fakebin/curl
chmod 755 fakebin/fakecomparefiles
chmod 755 fakebin/mkbin

# 同梱ディレクトリ (VERSION + 実行ホストの os_arch 版 compare_files)
exec mkbin bundled/compare-files compare_files v2.2.0 bundled
env stfw_plugin_bundled_dir=${WORK}/bundled

# --- 同梱あり・キャッシュなし: install なしで run が成功し、キャッシュは作られない ---
exec stfw run cmp
stderr 'compare_files=bundled'
! exists .stfw/cache/plugins/compare/compare-files

# --- 同梱が設定版と一致: plugin install はインストール済み (exit 3) で DL しない ---
execcode 3 stfw plugin install compare
! stderr 'download'
! exists .stfw/cache/plugins/compare/compare-files

# --- 設定版と同梱版が異なる: 同梱は使わず、不一致の理由を出す ---
# プロセスローカルの版上書きは provisioning の単位ではない (install は exit 3 のまま)。
# 利用者が原因と対処 (プロジェクト共通設定で上書きして install) を分かるよう stderr に出す。
execcode 6 stfw run cmpver
stderr 'is not installed'
stderr 'bundled compare-files is v2\.2\.0 but compare_files_version is v2\.2\.3'
stderr 'config/plugins/process/compare/config\.yml'
! stderr 'compare_files=bundled'
# プロジェクト共通設定で版を上書きした場合、install は同梱を使わず DL を試みる
mkdir config/plugins/process/compare
cp config.v999.yml config/plugins/process/compare/config.yml
execcode 6 stfw plugin install compare
stderr 'download failed'
rm config/plugins/process/compare/config.yml

# --- 永続キャッシュと同梱の両方がある: 永続キャッシュを優先する ---
exec mkbin .stfw/cache/plugins/compare/compare-files compare_files v2.2.0 cache
exec stfw run cmp
stderr 'compare_files=cache'
! stderr 'compare_files=bundled'

# --- stfw_plugin_bundled_dir 未設定: 従来どおり永続キャッシュのみ参照 ---
env stfw_plugin_bundled_dir=
rm .stfw/cache/plugins/compare/compare-files
execcode 6 stfw run cmp
stderr 'is not installed'

-- stfw.yml --
stfw:
  project_version: 0.1.0
  loglevel: "info"
-- config.v999.yml --
stfw:
  process:
    compare:
      compare_files_version: v9.9.9
